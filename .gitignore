tmp/
extra/
.claude/
# Each project's working tree is its own git repository (spec.md §5),
# so games/ must never be tracked by this repo.
games/
gamestudio.db
gamestudio.db-wal
gamestudio.db-shm
node_modules/
.DS_Store
# The deployed env file holds the API key and lives on the server, outside the
# work tree. deploy/studio.env.example is the committed template.
deploy/*.env
# Anywhere else too: the repository is public, and a studio.env beside the
# code is one `git add` away from putting its keys on GitHub.
*.env
# probes/ is tracked — it is what spec/ §14 is made of — but the key those
# scripts read is not. It stays in tmp/deepseek.key or $DEEPSEEK_API_KEY.
probes/*.key
