# Copy to ~/apps/studio.env and chmod 600. Never committed: it holds the key,
# and it is the one file on the box a deploy must not overwrite.
#
# Read only by deploy/ecosystem.config.cjs, which hands these to the studio process
# alone. Nothing here is exported to the shell or to any other app on the box.
#
# Paths must be absolute — there is no ~ expansion and no interpolation.

# Required. The server exits at boot without it.
DEEPSEEK_API_KEY=sk-replace-me

# Turns on `Secure` on the session cookie. TLS is terminated by the proxy, so
# nothing else in the process depends on this.
NODE_ENV=production

# The two listeners. Whatever the reverse proxy points at.
PORT=3005
GAMES_PORT=3001

# ⚠️ The exact origin of the games listener: scheme included, no trailing
# slash. Play links are built as ${GAMES_URL}/<slug>/, and the preview iframe's
# error reporter compares postMessage's event.origin against this URL's origin
# (public/main.js). Get it wrong and the problems panel silently receives
# nothing — it looks like a game that never breaks.
#
# Only needed because the two listeners have separate hostnames. On one
# hostname and two ports, leave it unset and the studio derives it per request.
GAMES_URL=https://games.example.com

# Read the client's address from X-Forwarded-For rather than the proxy's own.
# Without it the login lockout and the scoreboard limiter put every visitor in
# one bucket. Never set this unproxied: the header would then be whatever the
# client says it is.
TRUST_PROXY=1

# Outside the deployed work tree, which is force-checked-out on every push.
# The game trees restore themselves from git; the database does not.
DB_PATH=/home/ubuntu/apps/studio-data/db
GAMES_DIR=/home/ubuntu/apps/studio-data/games

# Optional. Studio-wide, resets at UTC midnight. Defaults to 5000000.
# DAILY_TOKEN_BUDGET=5000000
